[Unit]
Description=Keep this host and its peers findable despite the access point
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Two halves of the same problem, and they are not symmetrical.
#
# arp-announce says "this address is at this MAC" without being asked, so
# peers never have to ask. Measured on this network, that reaches the wired
# segment and not other wireless clients -- a cold-cache ping from here to
# wired eridani resolves 3 of 3, while the oven's broadcasts to this Pi were
# never received at all.
#
# arp-pin covers what announcing cannot: wireless peers this host must be
# able to reach, held from addresses the kernel already learned, verified
# each pass and released if they stop answering.
ExecStart=/usr/local/sbin/arp-announce
ExecStart=/usr/local/sbin/arp-pin
