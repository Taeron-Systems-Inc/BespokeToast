#!/bin/sh
# Hourly check that this radio still delivers group-addressed frames.
#
# On 2026-09-16 the access point's 2.4 GHz radio was found to have degraded
# after 155 days of uptime: group-addressed frames reached most stations
# exactly one time in ten, with no spread at all. Unicast was perfect
# throughout, so nothing noticed until a host with a cold cache could not
# find anything. Restarting the radio fixed it in forty seconds.
#
# It is expected to recur as uptime grows. The totals hide it; the GAPS
# identify it, because random loss cannot produce a clean 1-in-N.
#
# The alert is written to /var/lib/toaster/group-canary-ALERT.txt and sent
# to any logged-in session. It used to be posted to an agent relay shared
# with the router's operator; that channel is gone.
#
# The printer is the reference rather than the canary: it kept answering
# every probe even while the radio was degraded.
set -eu
REF=${GROUP_CANARY_REF:-10.20.10.234}
IFACE=$(ip -4 route show default | awk '{print $5; exit}')
SRC=$(ip -4 -o addr show dev "$IFACE" scope global | awk '{print $4}' | cut -d/ -f1)
LOG=/var/lib/toaster/group-canary.log
STATE=/var/lib/toaster/group-canary.state
mkdir -p /var/lib/toaster
OUT=$(VERBOSE=1 GAP=1 python3 /usr/local/sbin/arp-probe.py "$SRC" 12 "ref,$REF," 2>&1 || true)
GOT=$(printf '%s' "$OUT" | awk '/ref/ {print $2; exit}')
GOT=${GOT:-0}
NOW=$(date '+%Y-%m-%d %H:%M:%S %Z')
printf '%s  %s of 12 from %s\n' "$NOW" "$GOT" "$REF" >> "$LOG"
WAS=$(cat "$STATE" 2>/dev/null || echo ok)
if [ "$GOT" -le 4 ]; then
    NEW=degraded
else
    NEW=ok
fi
printf '%s' "$NEW" > "$STATE"
[ "$NEW" = "degraded" ] || exit 0
[ "$WAS" = "degraded" ] && exit 0      # already reported; say it once
ALERT=/var/lib/toaster/group-canary-ALERT.txt
{
  echo "CANARY: group-addressed delivery looks degraded again."
  echo
  echo "$NOW, from $SRC, broadcast ARP to the reference client $REF:"
  echo
  printf '%s\n' "$OUT"
  echo
  echo "The reference answered every probe, gaps all 1, while the radio"
  echo "was healthy. A clean 1-in-N gap pattern above is the 155-day"
  echo "fault returning, and a radio restart cleared it last time. Zero"
  echo "replies means the same thing with the pattern hidden: re-probe"
  echo "with more probes to see the gaps."
  echo
  echo "The fix is on the access point: wifi down wifi0 && wifi up wifi0."
  echo "wifi reload is a no-op there and looks like a clean negative."
} > "$ALERT"
# Said out loud as well as written down: a file nobody opens is not an
# alert. wall reaches any logged-in session; it is allowed to fail.
wall < "$ALERT" 2>/dev/null || true
